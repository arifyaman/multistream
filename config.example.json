{
  "mediamtx_api": "http://127.0.0.1:9997",
  "ingest_path": "live/REPLACE_WITH_YOUR_LONG_RANDOM_STREAM_NAME",
  "ingest_port": 1935,
  "refresh_sec": 2,
  "away_file": "/etc/multistream/away.mp4",
  "keys_dir": "/etc/multistream/keys",
  "restart_sec": 5,
  "start_limit_interval_sec": 60,
  "start_limit_burst": 5,
  "platforms": [
    {
      "name": "twitch",
      "push_url": "rtmp://live.twitch.tv/app/${TWITCH_KEY}"
    },
    {
      "name": "kick",
      "push_url": "rtmp://live.kick.com/${KICK_KEY}"
    },
    {
      "name": "youtube",
      "push_url": "rtmp://a.rtmp.youtube.com/live2/${YOUTUBE_STREAM_NAME}"
    }
  ]
}
